# Copy to .env and fill in real values. .env is gitignored — never commit it.

# Leave AUTH_USERNAME/AUTH_PASSWORD_HASH unset to disable login entirely (no
# login screen). Set both to require login. Generate a hash with:
#   node -e "require('bcryptjs').hash(process.argv[1], 10).then(console.log)" "yourpassword"
# AUTH_GROUP is which investment group this user is bound to — 'MPN' or 'RPS'.
# Defaults to 'MPN' when unset, so a single-user setup needs nothing extra.
AUTH_USERNAME=
AUTH_PASSWORD_HASH=
AUTH_GROUP=

# Additional users: repeat the three vars with a numeric suffix (_2, _3, ...).
# Each is a separate login bound to its own group; investments/masters/
# dashboard never mix across groups.
# AUTH_USERNAME_2=
# AUTH_PASSWORD_HASH_2=
# AUTH_GROUP_2=

# Random string for signing session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Server port (defaults to 3001 if unset)
API_PORT=3001
